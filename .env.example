# ─────────────────────────────────────────────────────────────────────────────
# NovaTrust AI Banking Assistant – Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# Groq API key (get yours free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Optional – override model name (default: llama3-8b-8192)
# GROQ_MODEL=llama3-8b-8192

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Bank configuration (for white-labelling)
BANK_NAME=NovaTrust Bank
BANK_HELPLINE=1800-NOVA-123
